# Upstash Redis Configuration (session store)
UPSTASH_REDIS_REST_URL=https://your_redis_url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Cloudflare R2 (file storage) — server-only, lihat juga .env.cloudflare
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=rafqr

# Batas upload. Prefix NEXT_PUBLIC_ wajib untuk nilai yang juga dipakai client
# (pre-check ukuran sebelum upload) — butuh redeploy kalau diubah.
NEXT_PUBLIC_MAX_FILE_MB=2048   # per file, default 2 GB
NEXT_PUBLIC_MAX_ZIP_MB=512    # batas memori JSZip, bukan batas transfer
MAX_SESSION_MB=10240          # total per sesi, server-only

# Supabase Configuration (analytics only — Postgres, bukan Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin dashboard secret (server-only, do NOT prefix with NEXT_PUBLIC_)
ADMIN_SECRET=change_this_to_a_long_random_string
